{
  "name": "schemastore.org",
  "version": "1.0.0",
  "description": "A collection of JSON Schemas",
  "readme": "../README.md",
  "private": true,
  "homepage": "http://schemastore.org",
  "bugs": {
    "url": "https://github.com/schemastore/SchemaStore/issues"
  },
  "license": "Apache 2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/schemastore/SchemaStore"
  },
  "devDependencies": {
    "grunt": "^1.0.1",
    "grunt-contrib-watch": "^1.0.0",
    "grunt-tv4": "^2.0.0",
    "grunt-http": "^2.2.0"
  },
  "oresLint": {
    "note": "Declared, not installed. ores-lint resolves these from a global install - see .ores-lint/README.md",
    "requires": {
      "eslint": ">=9",
      "typescript-eslint": ">=8 (optional; without it .ts files are skipped)"
    },
    "install": "npm i -g eslint typescript-eslint"
  },
  "scripts": {
    "lint:ores": "if [ -f ../.ores-lint/lint.sh ]; then sh ../.ores-lint/lint.sh; else echo 'ores-lint not installed'; fi",
    "prepublishOnly": "npm run lint:ores"
  }
}
